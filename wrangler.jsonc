{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "v2-nikadi-studio",
  "main": "worker.js",
  "compatibility_date": "2026-11-25",
  "assets": {
    "directory": "studio/dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  }
}
