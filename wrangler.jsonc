{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "v2-nikadi-studio",
  "main": "worker.js",
  "compatibility_date": "2026-11-25",
  "assets": {
    "directory": "studio/dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    { "binding": "R2", "bucket_name": "nikadi-studio" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "REALTIME_HUB", "class_name": "RealtimeHub" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_classes": ["RealtimeHub"] }
  ],
  "triggers": {
    "crons": [
      "* * * * *",
      "*/5 * * * *"
    ]
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  }
}
