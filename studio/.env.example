# Copy to .env.local and fill in. .env.local is git-ignored.
# Everything prefixed VITE_ is bundled into the browser JavaScript — never put a
# secret you wouldn't publish in .env.local or .env.production.

# Supabase (safe to expose: the anon/publishable key is protected by RLS)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Sender name shown on SMS
VITE_SMS_SENDER_ID=NIKADI

# --- DEVELOPMENT ONLY -------------------------------------------------------
# Provider tokens go in .env.development.local (git-ignored, and NOT loaded by
# `npm run build`), never in .env.local. In production the browser sends the
# signed-in user's session instead, and the Edge Functions (send-sms / send-wa)
# attach the provider token from Supabase secrets.
#
#   VITE_SMS_BEARER_TOKEN=your-messaging-service-bearer-token
#   VITE_WA_BEARER_TOKEN=your-messaging-service-bearer-token
#
# The data cleaner chat (Gemini). NO VITE_ prefix: vite.config.js reads it in Node
# for the dev server's /ai-clean, so it never reaches the browser. In production it
# is the Supabase secret GEMINI_API_KEY used by the ai-clean Edge Function.
#
#   GEMINI_API_KEY=your-gemini-api-key
#   GEMINI_MODEL=gemini-flash-lite-latest   (optional; this is the default)
